use io_error: std.io.error;
use std.print;
use std.runtime;
use std.system.os;
use std.text.parse;
use std.types.error.err;
use std.types.result.res;
use std.types.string.str;

use bench.data;
use h: bench.harness;
use bench.kernels;

# optional first positional argument: timed repetitions per kernel
fun reps_from_args(argc: i64, argv: **u8) i64 {
    if (argc < 2) { ret h.DEFAULT_REPS; }

    val r: res[i64, parse.ParseError] = parse.parse_i64(argv[1]::str, 10);
    if (sel r.err) { ret h.DEFAULT_REPS; }

    val n: i64 = r.ok;
    if (n < 1) { ret h.DEFAULT_REPS; }
    ret n;
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    val reps: i64 = reps_from_args(argc, argv);

    data.init();

    var i: i64 = 0;
    for (i < kernels.REGISTRY_LEN) {
        val e: err[io_error.Error] = h.run(kernels.REGISTRY[i], reps);
        if (sel e.err) {
            print.eprintlnf("mach-bench: {}: clock failed: {}", kernels.REGISTRY[i].name, os.message(e.err));
            ret 1;
        }
        i = i + 1;
    }

    ret 0;
}
