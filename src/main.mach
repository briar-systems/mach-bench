use std.runtime;
use std.types.string.str;
use std.types.result.Result;
use std.types.result.is_err;
use std.types.result.unwrap_ok;
use parse: std.text.parse;

use bench.data;
use bench.kernels;
use h: bench.harness;

# optional first positional argument: timed repetitions per kernel
fun reps_from_args(argc: i64, argv: **u8) i64 {
    if (argc < 2) { ret h.DEFAULT_REPS; }

    val r: Result[i64, str] = parse.parse_i64(argv[1]::str, 10);
    if (is_err[i64, str](r)) { ret h.DEFAULT_REPS; }

    val n: i64 = unwrap_ok[i64, str](r);
    if (n < 1) { ret h.DEFAULT_REPS; }
    ret n;
}

#[symbol("main")]
fun main(argc: i64, argv: **u8) i64 {
    val reps: i64 = reps_from_args(argc, argv);

    data.init();

    var i: i64 = 0;
    for (i < kernels.REGISTRY_LEN) {
        h.run(kernels.REGISTRY[i], reps);
        i = i + 1;
    }

    ret 0;
}
