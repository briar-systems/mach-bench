    h.Kernel{name: "call_direct", fn: k_call_direct, iters: 50, tol: 0.0, group: G_GENERAL, basis: LIKE},
    h.Kernel{name: "rec_return", fn: k_rec_return, iters: 5, tol: 0.0, group: G_GENERAL, basis: LIKE},
    h.Kernel{name: "rec_update", fn: k_rec_update, iters: 100, tol: 0.0, group: G_GENERAL, basis: LIKE},
