# the benchmark kernels
#
# each kernel mirrors its counterpart in c/kernels.c statement for statement.
# they live in their own module so the timing loop in bench.harness cannot
# inline through them or hoist them out.

use std.types.result.res;
use std.types.string.str;

use d: bench.data;
use h: bench.harness;

# every kernel, and every function a kernel calls, starts on a 64-byte boundary,
# so where one lands does not depend on the code linked ahead of it. c/kernels.c
# is built with -falign-functions=64 for the same reason. the loop inside is
# placed by the compiler, and stays part of what a row measures
val KERNEL_ALIGN: i64 = 64;

# contiguous f32 multiply-add into a distinct output -- the textbook
# autovectorisation target
#[align(KERNEL_ALIGN)]
fun k_f32_saxpy() f64 {
    val alpha: f32 = 1.0009765625;
    var i:     i64 = 0;
    for (i < d.N_SMALL) {
        d.f32_out[i] = alpha * d.f32_a[i] + d.f32_b[i];
        i            = i + 1;
    }
    ret d.f32_out[0]::f64 + d.f32_out[d.N_SMALL / 2]::f64 + d.f32_out[d.N_SMALL - 1]::f64;
}

# f64 reduction: vectorising this reassociates the sum, so the checksum is
# compared with a relative tolerance rather than bit-exactly
#[align(KERNEL_ALIGN)]
fun k_f64_dot() f64 {
    var acc: f64 = 0.0;
    var i:   i64 = 0;
    for (i < d.N_SMALL) {
        acc = acc + d.f64_a[i] * d.f64_b[i];
        i   = i + 1;
    }
    ret acc;
}

# f32 sum of squares -- reduction with a single multiply per element
#[align(KERNEL_ALIGN)]
fun k_f32_norm() f64 {
    var acc: f32 = 0.0;
    var i:   i64 = 0;
    for (i < d.N_SMALL) {
        acc = acc + d.f32_a[i] * d.f32_a[i];
        i   = i + 1;
    }
    ret acc::f64;
}

# integer multiply-accumulate; inputs stay in [0,255] so the i64 total is
# exactly representable as f64
#[align(KERNEL_ALIGN)]
fun k_i32_madd() f64 {
    var acc: i64 = 0;
    var i:   i64 = 0;
    for (i < d.N_SMALL) {
        acc = acc + (d.i32_a[i]::i64) * (d.i32_b[i]::i64);
        i   = i + 1;
    }
    ret acc::f64;
}

# byte scan with a compare-accumulate -- vectorises to a packed compare
#[align(KERNEL_ALIGN)]
fun k_u8_count() f64 {
    var n: i64 = 0;
    var i: i64 = 0;
    for (i < d.N_BYTES) {
        if (d.u8_a[i] > 127) { n = n + 1; }
        i = i + 1;
    }
    ret n::f64;
}

# FNV-1a over the byte array. each step depends on the previous one, so this is
# the control case: a correct vectoriser must leave it scalar
#[align(KERNEL_ALIGN)]
fun k_u64_fnv1a() f64 {
    var hash: u64 = 0xCBF29CE484222325; # FNV-1a 64-bit offset basis
    var i:    i64 = 0;
    for (i < d.N_BYTES) {
        hash = hash ^ (d.u8_a[i]::u64);
        hash = hash * 0x100000001B3; # FNV-1a 64-bit prime
        i    = i + 1;
    }
    ret (hash % 1000000007)::f64;
}

# data-dependent branch -- tests whether the branch becomes a predicated select
# or stays a mispredicting jump
#[align(KERNEL_ALIGN)]
fun k_i32_filter_sum() f64 {
    var acc: i64 = 0;
    var i:   i64 = 0;
    for (i < d.N_SMALL) {
        if (d.i32_a[i] > d.i32_b[i]) { acc = acc + d.i32_a[i]::i64; }
        i = i + 1;
    }
    ret acc::f64;
}

# loop-carried dependency: each output needs the previous one
#[align(KERNEL_ALIGN)]
fun k_i64_prefix_sum() f64 {
    var acc: i64 = 0;
    var i:   i64 = 0;
    for (i < d.N_SMALL) {
        acc          = acc + d.i32_a[i]::i64;
        d.i64_out[i] = acc;
        i            = i + 1;
    }
    ret d.i64_out[d.N_SMALL - 1]::f64;
}

# naive ikj matmul -- the inner loop is a scalar-times-vector accumulate
#[align(KERNEL_ALIGN)]
fun k_f32_matmul() f64 {
    var z: i64 = 0;
    for (z < d.MAT_ELEMS) {
        d.mat_out[z] = 0.0;
        z            = z + 1;
    }

    var i: i64 = 0;
    for (i < d.MAT_N) {
        var k: i64 = 0;
        for (k < d.MAT_N) {
            val aik: f32 = d.mat_a[i * d.MAT_N + k];
            var j:   i64 = 0;
            for (j < d.MAT_N) {
                d.mat_out[i * d.MAT_N + j] = d.mat_out[i * d.MAT_N + j] + aik * d.mat_b[k * d.MAT_N + j];
                j                          = j + 1;
            }
            k = k + 1;
        }
        i = i + 1;
    }

    ret d.mat_out[0]::f64 + d.mat_out[d.MAT_ELEMS - 1]::f64;
}

# STREAM triad over a 24 MB working set -- bandwidth bound, so both sides should
# converge regardless of how well the loop vectorises
#[align(KERNEL_ALIGN)]
fun k_stream_triad() f64 {
    val scalar: f32 = 3.0;
    var i:      i64 = 0;
    for (i < d.N_STREAM) {
        d.st_out[i] = d.st_a[i] + scalar * d.st_b[i];
        i           = i + 1;
    }
    ret d.st_out[0]::f64 + d.st_out[d.N_STREAM / 2]::f64 + d.st_out[d.N_STREAM - 1]::f64;
}

# three-point stencil: the same loop as saxpy with the index offset by one
# either way, which is what a vectoriser has to see through
#[align(KERNEL_ALIGN)]
fun k_f32_stencil() f64 {
    var i: i64 = 1;
    for (i < d.N_SMALL - 1) {
        d.f32_out[i] = (d.f32_a[i - 1] + d.f32_a[i]) + d.f32_a[i + 1];
        i            = i + 1;
    }
    ret d.f32_out[1]::f64 + d.f32_out[d.N_SMALL / 2]::f64 + d.f32_out[d.N_SMALL - 2]::f64;
}

# bytes widened to float and scaled -- unsigned to float at mixed lane widths
#[align(KERNEL_ALIGN)]
fun k_u8_to_f32() f64 {
    var i: i64 = 0;
    for (i < d.N_SMALL) {
        d.f32_out[i] = (d.u8_a[i]::f32) * 0.00390625;
        i            = i + 1;
    }
    ret d.f32_out[0]::f64 + d.f32_out[d.N_SMALL / 2]::f64 + d.f32_out[d.N_SMALL - 1]::f64;
}

# bytes summed into a 64-bit total -- the plain widening reduction
#[align(KERNEL_ALIGN)]
fun k_u8_sum() f64 {
    var acc: i64 = 0;
    var i:   i64 = 0;
    for (i < d.N_BYTES) {
        acc = acc + d.u8_a[i]::i64;
        i   = i + 1;
    }
    ret acc::f64;
}

# a byte copy written as a loop -- whatever each compiler makes of it
#[align(KERNEL_ALIGN)]
fun k_bulk_copy() f64 {
    var i: i64 = 0;
    for (i < d.N_BYTES) {
        d.u8_out[i] = d.u8_a[i];
        i           = i + 1;
    }
    ret d.u8_out[0]::f64 + d.u8_out[d.N_BYTES / 2]::f64 + d.u8_out[d.N_BYTES - 1]::f64;
}

# a byte fill written as a loop
#[align(KERNEL_ALIGN)]
fun k_bulk_fill() f64 {
    var i: i64 = 0;
    for (i < d.N_BYTES) {
        d.u8_out[i] = 0x5A;
        i           = i + 1;
    }
    ret d.u8_out[0]::f64 + d.u8_out[d.N_BYTES / 2]::f64 + d.u8_out[d.N_BYTES - 1]::f64;
}

# many short copies whose length comes from the data, 8 to 39 bytes each -- the
# case where a bulk copy's setup cost shows
#[align(KERNEL_ALIGN)]
fun k_copy_short() f64 {
    var total: i64 = 0;
    var r:     i64 = 0;
    for (r < d.N_BYTES / 64) {
        val n:   i64 = 8 + (d.u8_a[r] & 31)::i64;
        val src: *u8 = ?d.u8_a[r * 64];
        val dst: *u8 = ?d.u8_out[r * 64];
        var j:   i64 = 0;
        for (j < n) {
            dst[j] = src[j];
            j      = j + 1;
        }
        total = total + n;
        r     = r + 1;
    }
    ret total::f64 + d.u8_out[d.N_BYTES - 64]::f64;
}

# multi-limb add with the carry written as compares, the portable spelling
#[align(KERNEL_ALIGN)]
fun k_limb_add() f64 {
    var carry: u64 = 0;
    var fold:  u64 = 0;
    var i:     i64 = 0;
    for (i < d.N_LIMB) {
        val s:  u64 = d.limb_a[i] + d.limb_b[i];
        val c1: u64 = (s < d.limb_a[i])::u64;
        val t:  u64 = s + carry;
        val c2: u64 = (t < s)::u64;
        d.limb_out[i] = t;
        fold          = fold ^ t;
        carry         = c1 | c2;
        i             = i + 1;
    }
    ret (fold % 1000000007)::f64 + carry::f64;
}

# a serial mixer whose rotates are written as shift pairs -- each one should
# become a single rotate
#[align(KERNEL_ALIGN)]
fun k_hash_mix() f64 {
    var h: u64 = 0x9E3779B97F4A7C15;
    var i: i64 = 0;
    for (i < d.N_LIMB) {
        var k: u64 = d.limb_a[i] * 0x87C37B91114253D5;
        k = (k << 31) | (k >> 33);
        k = k * 0x4CF5AD432745937F;
        h = h ^ k;
        h = (h << 27) | (h >> 37);
        h = h * 5 + 0x52DCE729;
        i = i + 1;
    }
    ret (h % 1000000007)::f64;
}

pub def StepFun: fun(i32) i32;

#[align(KERNEL_ALIGN)]
fun step_add(v: i32) i32 {
    ret v + 1;
}

#[align(KERNEL_ALIGN)]
fun step_mul(v: i32) i32 {
    ret v * 2;
}

# exported mutable table so neither compiler can constant-fold the dispatch
pub var steps: [2]StepFun = [2]StepFun{step_add, step_mul};

# indirect call through a data-dependent function pointer. neither compiler can
# devirtualise it, so this is call overhead with inlining taken off the table
#[align(KERNEL_ALIGN)]
fun k_call_indirect() f64 {
    var acc: i64 = 0;
    var i:   i64 = 0;
    for (i < d.N_SMALL) {
        val f: StepFun = steps[(d.i32_a[i] & 1)::i64];
        acc = acc + (f(d.i32_a[i] & 0xFF)::i64);
        i   = i + 1;
    }
    ret acc::f64;
}

# array-of-structures traversal: six f32 fields at a 24-byte stride. the f64
# accumulator keeps the result exact, so this stays a bit-exact comparison.
# the three terms are summed before they reach acc, as C's `acc += a + b + c`
# sums them: float addition does not regroup, so the grouping is the kernel
#[align(KERNEL_ALIGN)]
fun k_rec_particle() f64 {
    val dt:  f32 = 0.00390625;
    var acc: f64 = 0.0;
    var i:   i64 = 0;
    for (i < d.N_PART) {
        acc = acc + ((d.parts[i].x + d.parts[i].vx * dt)::f64
            + (d.parts[i].y + d.parts[i].vy * dt)::f64
            + (d.parts[i].z + d.parts[i].vz * dt)::f64);
        i = i + 1;
    }
    ret acc;
}

# pointer chasing over a random Hamiltonian cycle. every load depends on the
# previous one, so this is memory latency with prefetching defeated
#[align(KERNEL_ALIGN)]
fun k_list_walk() f64 {
    var p:   i32 = 0;
    var acc: i64 = 0;
    var i:   i64 = 0;
    for (i < d.N_SMALL) {
        p   = d.chase[p::i64];
        acc = acc + p::i64;
        i   = i + 1;
    }
    ret acc::f64;
}

# branchy dispatch over an unpredictable opcode stream. Mach has no switch, so
# both sides use an if/else chain and the comparison stays like-for-like
#[align(KERNEL_ALIGN)]
fun k_branch_dispatch() f64 {
    var acc: i64 = 0;
    var reg: i64 = 1;
    var i:   i64 = 0;
    for (i < d.N_BYTES) {
        val op: i64 = (d.u8_a[i] & 3)::i64;
        if (op == 0) {
            reg = reg + 3;
        }
        or (op == 1) {
            reg = reg ^ 0x5A;
        }
        or (op == 2) {
            reg = (reg >> 1) + 1;
        }
        or {
            acc = acc + (reg & 0xFF);
        }
        i = i + 1;
    }
    ret acc::f64;
}

# insertion sort over independent blocks -- compare, branch and shift heavy, and
# refilled each call so it stays idempotent
#[align(KERNEL_ALIGN)]
fun k_sort_blocks() f64 {
    var i: i64 = 0;
    for (i < d.N_SORT) {
        d.sortbuf[i] = d.i32_a[i];
        i            = i + 1;
    }

    var b: i64 = 0;
    for (b < d.N_SORT) {
        i = b + 1;
        for (i < b + d.SORT_BLOCK) {
            val v: i32 = d.sortbuf[i];
            var j: i64 = i - 1;
            for (j >= b && d.sortbuf[j] > v) {
                d.sortbuf[j + 1] = d.sortbuf[j];
                j                = j - 1;
            }
            d.sortbuf[j + 1] = v;
            i                = i + 1;
        }
        b = b + d.SORT_BLOCK;
    }

    # position-weighted so a wrong ordering cannot checksum equal
    var acc: i64 = 0;
    i = 0;
    for (i < d.N_SORT) {
        acc = acc + (i + 1) * (d.sortbuf[i]::i64);
        i   = i + 1;
    }
    ret acc::f64;
}

#[align(KERNEL_ALIGN)]
fun fib(n: i64) i64 {
    if (n < 2) { ret n; }
    ret fib(n - 1) + fib(n - 2);
}

# naive recursion: call overhead, stack traffic, and whatever the optimiser does
# with a self-recursive tree
#[align(KERNEL_ALIGN)]
fun k_recurse_fib() f64 {
    ret fib(d.FIB_N)::f64;
}

# naive substring search -- nested loop with an early exit
#[align(KERNEL_ALIGN)]
fun k_str_search() f64 {
    var found: i64 = -1;
    var i:     i64 = 0;
    for (i + d.NEEDLE_LEN <= d.N_BYTES) {
        var k: i64 = 0;
        for (k < d.NEEDLE_LEN && d.u8_a[i + k] == d.needle[k]) {
            k = k + 1;
        }
        if (k == d.NEEDLE_LEN) {
            found = i;
            brk;
        }
        i = i + 1;
    }
    ret found::f64;
}

# binary search: unpredictable branches over a working set larger than L2
#[align(KERNEL_ALIGN)]
fun k_binsearch() f64 {
    var acc: i64 = 0;
    var q:   i64 = 0;
    for (q < d.N_QUERY) {
        val key: i32 = ((d.i32_a[q] * 17 + (q::i32) * 3) % ((2 * d.N_SMALL)::i32));
        var lo:  i64 = 0;
        var hi:  i64 = d.N_SMALL - 1;
        var res: i64 = -1;
        for (lo <= hi) {
            val mid: i64 = (lo + hi) / 2;
            if (d.sorted_a[mid] == key) {
                res = mid;
                brk;
            }
            if (d.sorted_a[mid] < key) {
                lo = mid + 1;
            }
            or {
                hi = mid - 1;
            }
        }
        acc = acc + res;
        q   = q + 1;
    }
    ret acc::f64;
}

#[align(KERNEL_ALIGN)]
#[inline("never")]
fun step_scale(v: i32, k: i32) i32 {
    ret v * k + 1;
}

# a direct call neither side may inline -- call overhead with nothing for the
# optimiser to rewrite
#[align(KERNEL_ALIGN)]
fun k_call_direct() f64 {
    var acc: i64 = 0;
    var i:   i64 = 0;
    for (i < d.N_SMALL) {
        acc = acc + step_scale(d.i32_a[i], d.i32_b[i])::i64;
        i   = i + 1;
    }
    ret acc::f64;
}

rec Box {
    a: i64;
    b: i64;
    c: i64;
    d: i64;
    e: i64;
}

#[align(KERNEL_ALIGN)]
#[inline("never")]
fun box_make(v: i32) Box {
    val x: Box = Box{a: v::i64, b: (v::i64) * 2, c: (v + 3)::i64, d: (v ^ 5)::i64, e: 1};
    ret x;
}

#[align(KERNEL_ALIGN)]
#[inline("never")]
fun box_step(x: Box) Box {
    var y: Box = x;
    y.a = x.a + x.e;
    y.e = x.e + x.b;
    ret y;
}

# a 40-byte record made, passed and returned by value through calls neither
# side may inline -- what an aggregate costs to move across a call
#[align(KERNEL_ALIGN)]
fun k_rec_return() f64 {
    var acc: i64 = 0;
    var i:   i64 = 0;
    for (i < d.N_SMALL) {
        val b0: Box = box_make(d.i32_a[i]);
        val b1: Box = box_step(b0);
        val b2: Box = box_step(b1);
        acc = acc + (b2.a + b2.e);
        i   = i + 1;
    }
    ret acc::f64;
}

# array-of-structures update: three fields read, three stored back, at a
# 36-byte stride
#[align(KERNEL_ALIGN)]
fun k_rec_update() f64 {
    val dt: f32 = 0.00390625;
    var i:  i64 = 0;
    for (i < d.N_PART) {
        d.bodies[i].nx = d.bodies[i].x + d.bodies[i].vx * dt;
        d.bodies[i].ny = d.bodies[i].y + d.bodies[i].vy * dt;
        d.bodies[i].nz = d.bodies[i].z + d.bodies[i].vz * dt;
        i              = i + 1;
    }
    ret d.bodies[0].nx::f64 + d.bodies[d.N_PART / 2].ny::f64 + d.bodies[d.N_PART - 1].nz::f64;
}

# sixteen-way dispatch over an unpredictable opcode stream, as an if/or chain on
# both sides. every arm keeps reg under 2^20, so nothing overflows
#[align(KERNEL_ALIGN)]
fun k_op_dispatch() f64 {
    var acc: i64 = 0;
    var reg: i64 = 1;
    var i:   i64 = 0;
    for (i < d.N_BYTES) {
        val op: i64 = (d.u8_a[i] & 15)::i64;
        if (op == 0) {
            reg = (reg + 3) & 0xFFFFF;
        }
        or (op == 1) {
            reg = reg ^ 0x5A;
        }
        or (op == 2) {
            reg = (reg >> 1) + 1;
        }
        or (op == 3) {
            acc = acc + (reg & 0xFF);
        }
        or (op == 4) {
            reg = (reg * 3) & 0xFFFFF;
        }
        or (op == 5) {
            reg = reg | 0x11;
        }
        or (op == 6) {
            reg = reg & 0xFFF;
        }
        or (op == 7) {
            acc = acc + (reg >> 12);
        }
        or (op == 8) {
            reg = (reg + acc) & 0xFFFFF;
        }
        or (op == 9) {
            acc = acc + 1;
        }
        or (op == 10) {
            reg = (reg << 2) & 0xFFFFF;
        }
        or (op == 11) {
            acc = acc + (reg & 0x0F);
        }
        or (op == 12) {
            reg = reg ^ (reg >> 3);
        }
        or (op == 13) {
            reg = (reg + 0x1234) & 0xFFFFF;
        }
        or (op == 14) {
            acc = acc + ((reg >> 4) & 0x3F);
        }
        or {
            reg = (reg * 5 + 1) & 0xFFFFF;
        }
        i = i + 1;
    }
    ret acc::f64;
}

# decimal integers parsed from a byte buffer -- short data-dependent loops and
# compares on every byte
#[align(KERNEL_ALIGN)]
fun k_parse_ints() f64 {
    var sum:   i64 = 0;
    var count: i64 = 0;
    var i:     i64 = 0;
    for (i < d.N_TEXT) {
        for (i < d.N_TEXT && d.text[i] == 32) {
            i = i + 1;
        }
        if (i >= d.N_TEXT) {
            brk;
        }
        var v: i64 = 0;
        for (i < d.N_TEXT && d.text[i] >= 48 && d.text[i] <= 57) {
            v = v * 10 + (d.text[i] - 48)::i64;
            i = i + 1;
        }
        sum   = sum + v;
        count = count + 1;
    }
    ret (sum + count)::f64;
}

#[align(KERNEL_ALIGN)]
fun tree_walk(n: i32) i64 {
    if (n < 0) { ret 0; }
    ret d.nodes[n::i64].val::i64 + tree_walk(d.nodes[n::i64].left) + tree_walk(d.nodes[n::i64].right);
}

# recursive walk of a tree stored in shuffled order -- recursion whose shape
# comes from the data
#[align(KERNEL_ALIGN)]
fun k_tree_sum() f64 {
    ret tree_walk(d.tree_root)::f64;
}

# Mach-idiomatic error handling: res[i64, StepError] checked every iteration on
# a path that never fails. c/kernels.c uses an int status plus an
# out-parameter, so this measures each language's ordinary error-propagation
# idiom
tag StepError: u8 { negative; }

#[align(KERNEL_ALIGN)]
fun step_checked(v: i32) res[i64, StepError] {
    if (v < 0) { ret res[i64, StepError].err{StepError.negative{}}; }
    ret res[i64, StepError].ok{(v::i64) * 3 + 1};
}

#[align(KERNEL_ALIGN)]
fun k_result_chain() f64 {
    var acc: i64 = 0;
    var i:   i64 = 0;
    for (i < d.N_SMALL) {
        val r: res[i64, StepError] = step_checked(d.i32_a[i]);
        if (sel r.err) { ret -1.0; }
        acc = acc + r.ok;
        i   = i + 1;
    }
    ret acc::f64;
}

rec Fault {
    code: i64;
    at:   i64;
    arg:  i64;
}

#[align(KERNEL_ALIGN)]
#[inline("never")]
fun step_wide(v: i32, at: i64) res[i64, Fault] {
    if (v < 0) { ret res[i64, Fault].err{Fault{code: 1, at: at, arg: v::i64}}; }
    ret res[i64, Fault].ok{(v::i64) * 3 + at};
}

# the same error path with a three-word error record and a callee neither side
# may inline. c/kernels.c uses a status and two out-parameters, so this
# measures what each language's convention costs when the call is a real one
#[align(KERNEL_ALIGN)]
fun k_result_wide() f64 {
    var acc: i64 = 0;
    var i:   i64 = 0;
    for (i < d.N_SMALL) {
        val r: res[i64, Fault] = step_wide(d.i32_a[i], i);
        if (sel r.err) { ret (0 - r.err.code)::f64; }
        acc = acc + r.ok;
        i   = i + 1;
    }
    ret acc::f64;
}

# a `tag` read with `sel`. c/kernels.c reads a tagged union with a switch
#[align(KERNEL_ALIGN)]
fun k_tag_dispatch() f64 {
    var acc: i64 = 0;
    var i:   i64 = 0;
    for (i < d.N_ITEM) {
        if (sel d.items[i].small) {
            acc = acc + d.items[i].small::i64;
        }
        or (sel d.items[i].pair) {
            acc = acc + (d.items[i].pair.a::i64) * (d.items[i].pair.b::i64);
        }
        or (sel d.items[i].wide) {
            acc = acc + (d.items[i].wide >> 4);
        }
        or {
            acc = acc + 1;
        }
        i = i + 1;
    }
    ret acc::f64;
}

# saxpy written with explicit vectors over array windows -- vector lowering
# with the autovectoriser taken out of it. c/kernels.c uses the GCC vector
# extension
#[align(KERNEL_ALIGN)]
fun k_vec_saxpy() f64 {
    val alpha: f32x4 = f32x4{1.0009765625, 1.0009765625, 1.0009765625, 1.0009765625};
    var i:     i64   = 0;
    for (i < d.N_SMALL) {
        val x: f32x4 = d.f32_a[i, 4]::f32x4;
        val y: f32x4 = d.f32_b[i, 4]::f32x4;
        d.f32_out[i, 4] = (alpha * x + y)::[4]f32;
        i               = i + 4;
    }
    ret d.f32_out[0]::f64 + d.f32_out[d.N_SMALL / 2]::f64 + d.f32_out[d.N_SMALL - 1]::f64;
}

# the registry, in the same order as c/kernels.c.
# adding a kernel means bumping REGISTRY_LEN and adding the matching entry in
# c/kernels.c -- the two registries must stay name-for-name identical.
pub val REGISTRY_LEN: i64 = 36;

val G_LOOPS:   str = "array loops";
val G_GENERAL: str = "general codegen";
val G_IDIOMS:  str = "idioms";

val LIKE:  str = "like";
val IDIOM: str = "idiom";

pub val REGISTRY: [REGISTRY_LEN]h.Kernel = [REGISTRY_LEN]h.Kernel{
    h.Kernel{name: "f32_saxpy", fn: k_f32_saxpy, iters: 100, tol: 0.0, group: G_LOOPS, basis: LIKE},
    h.Kernel{name: "f64_dot", fn: k_f64_dot, iters: 100, tol: 0.0, group: G_LOOPS, basis: LIKE},
    h.Kernel{name: "f32_norm", fn: k_f32_norm, iters: 100, tol: 0.001, group: G_LOOPS, basis: LIKE},
    h.Kernel{name: "i32_madd", fn: k_i32_madd, iters: 100, tol: 0.0, group: G_LOOPS, basis: LIKE},
    h.Kernel{name: "u8_count", fn: k_u8_count, iters: 50, tol: 0.0, group: G_LOOPS, basis: LIKE},
    h.Kernel{name: "u64_fnv1a", fn: k_u64_fnv1a, iters: 10, tol: 0.0, group: G_LOOPS, basis: LIKE},
    h.Kernel{name: "i32_filter_sum", fn: k_i32_filter_sum, iters: 100, tol: 0.0, group: G_LOOPS, basis: LIKE},
    h.Kernel{name: "i64_prefix_sum", fn: k_i64_prefix_sum, iters: 100, tol: 0.0, group: G_LOOPS, basis: LIKE},
    h.Kernel{name: "f32_matmul", fn: k_f32_matmul, iters: 10, tol: 0.0001, group: G_LOOPS, basis: LIKE},
    h.Kernel{name: "stream_triad", fn: k_stream_triad, iters: 5, tol: 0.0, group: G_LOOPS, basis: LIKE},
    h.Kernel{name: "f32_stencil", fn: k_f32_stencil, iters: 100, tol: 0.0, group: G_LOOPS, basis: LIKE},
    h.Kernel{name: "u8_to_f32", fn: k_u8_to_f32, iters: 100, tol: 0.0, group: G_LOOPS, basis: LIKE},
    h.Kernel{name: "u8_sum", fn: k_u8_sum, iters: 50, tol: 0.0, group: G_LOOPS, basis: LIKE},
    h.Kernel{name: "bulk_copy", fn: k_bulk_copy, iters: 100, tol: 0.0, group: G_LOOPS, basis: LIKE},
    h.Kernel{name: "bulk_fill", fn: k_bulk_fill, iters: 100, tol: 0.0, group: G_LOOPS, basis: LIKE},
    h.Kernel{name: "copy_short", fn: k_copy_short, iters: 50, tol: 0.0, group: G_LOOPS, basis: LIKE},
    h.Kernel{name: "limb_add", fn: k_limb_add, iters: 100, tol: 0.0, group: G_LOOPS, basis: LIKE},
    h.Kernel{name: "hash_mix", fn: k_hash_mix, iters: 50, tol: 0.0, group: G_LOOPS, basis: LIKE},

    h.Kernel{name: "call_indirect", fn: k_call_indirect, iters: 50, tol: 0.0, group: G_GENERAL, basis: LIKE},
    h.Kernel{name: "rec_particle", fn: k_rec_particle, iters: 50, tol: 0.0, group: G_GENERAL, basis: LIKE},
    h.Kernel{name: "list_walk", fn: k_list_walk, iters: 20, tol: 0.0, group: G_GENERAL, basis: LIKE},
    h.Kernel{name: "branch_dispatch", fn: k_branch_dispatch, iters: 10, tol: 0.0, group: G_GENERAL, basis: LIKE},
    h.Kernel{name: "sort_blocks", fn: k_sort_blocks, iters: 20, tol: 0.0, group: G_GENERAL, basis: LIKE},
    h.Kernel{name: "recurse_fib", fn: k_recurse_fib, iters: 5, tol: 0.0, group: G_GENERAL, basis: LIKE},
