# the benchmark kernels
#
# each kernel mirrors its counterpart in c/kernels.c statement for statement.
# they live in their own module so the timing loop in bench.harness cannot
# inline through them or hoist them out.

use std.types.result.res;
use std.types.string.str;

use d: bench.data;
use h: bench.harness;

# contiguous f32 multiply-add into a distinct output -- the textbook
# autovectorisation target
fun k_f32_saxpy() f64 {
    val alpha: f32 = 1.0009765625;
    var i: i64 = 0;
    for (i < d.N_SMALL) {
        d.f32_out[i] = alpha * d.f32_a[i] + d.f32_b[i];
        i = i + 1;
    }
    ret d.f32_out[0]::f64 + d.f32_out[d.N_SMALL / 2]::f64 + d.f32_out[d.N_SMALL - 1]::f64;
}

# f64 reduction: vectorising this reassociates the sum, so the checksum is
# compared with a relative tolerance rather than bit-exactly
fun k_f64_dot() f64 {
    var acc: f64 = 0.0;
    var i: i64 = 0;
    for (i < d.N_SMALL) {
        acc = acc + d.f64_a[i] * d.f64_b[i];
        i = i + 1;
    }
    ret acc;
}

# f32 sum of squares -- reduction with a single multiply per element
fun k_f32_norm() f64 {
    var acc: f32 = 0.0;
    var i: i64 = 0;
    for (i < d.N_SMALL) {
        acc = acc + d.f32_a[i] * d.f32_a[i];
        i = i + 1;
    }
    ret acc::f64;
}

# integer multiply-accumulate; inputs stay in [0,255] so the i64 total is
# exactly representable as f64
fun k_i32_madd() f64 {
    var acc: i64 = 0;
    var i: i64 = 0;
    for (i < d.N_SMALL) {
        acc = acc + (d.i32_a[i]::i64) * (d.i32_b[i]::i64);
        i = i + 1;
    }
    ret acc::f64;
}

# byte scan with a compare-accumulate -- vectorises to a packed compare
fun k_u8_count() f64 {
    var n: i64 = 0;
    var i: i64 = 0;
    for (i < d.N_BYTES) {
        if (d.u8_a[i] > 127) { n = n + 1; }
        i = i + 1;
    }
    ret n::f64;
}

# FNV-1a over the byte array. each step depends on the previous one, so this is
# the control case: a correct vectoriser must leave it scalar
fun k_u64_fnv1a() f64 {
    var hash: u64 = 0xCBF29CE484222325; # FNV-1a 64-bit offset basis
    var i: i64 = 0;
    for (i < d.N_BYTES) {
        hash = hash ^ (d.u8_a[i]::u64);
        hash = hash * 0x100000001B3;    # FNV-1a 64-bit prime
        i = i + 1;
    }
    ret (hash % 1000000007)::f64;
}

# data-dependent branch -- tests whether the branch becomes a predicated select
# or stays a mispredicting jump
fun k_i32_filter_sum() f64 {
    var acc: i64 = 0;
    var i: i64 = 0;
    for (i < d.N_SMALL) {
        if (d.i32_a[i] > d.i32_b[i]) { acc = acc + d.i32_a[i]::i64; }
        i = i + 1;
    }
    ret acc::f64;
}

# loop-carried dependency: each output needs the previous one
fun k_i64_prefix_sum() f64 {
    var acc: i64 = 0;
    var i: i64 = 0;
    for (i < d.N_SMALL) {
        acc = acc + d.i32_a[i]::i64;
        d.i64_out[i] = acc;
        i = i + 1;
    }
    ret d.i64_out[d.N_SMALL - 1]::f64;
}

# naive ikj matmul -- the inner loop is a scalar-times-vector accumulate
fun k_f32_matmul() f64 {
    var z: i64 = 0;
    for (z < d.MAT_ELEMS) {
        d.mat_out[z] = 0.0;
        z = z + 1;
    }

    var i: i64 = 0;
    for (i < d.MAT_N) {
        var k: i64 = 0;
        for (k < d.MAT_N) {
            val aik: f32 = d.mat_a[i * d.MAT_N + k];
            var j: i64 = 0;
            for (j < d.MAT_N) {
                d.mat_out[i * d.MAT_N + j] = d.mat_out[i * d.MAT_N + j] + aik * d.mat_b[k * d.MAT_N + j];
                j = j + 1;
            }
            k = k + 1;
        }
        i = i + 1;
    }

    ret d.mat_out[0]::f64 + d.mat_out[d.MAT_ELEMS - 1]::f64;
}

# STREAM triad over a 24 MB working set -- bandwidth bound, so both sides should
# converge regardless of how well the loop vectorises
fun k_stream_triad() f64 {
    val scalar: f32 = 3.0;
    var i: i64 = 0;
    for (i < d.N_STREAM) {
        d.st_out[i] = d.st_a[i] + scalar * d.st_b[i];
        i = i + 1;
    }
    ret d.st_out[0]::f64 + d.st_out[d.N_STREAM / 2]::f64 + d.st_out[d.N_STREAM - 1]::f64;
}

def StepFun: fun(i32) i32;

fun step_add(v: i32) i32 { ret v + 1; }
fun step_mul(v: i32) i32 { ret v * 2; }

var steps: [2]StepFun = [2]StepFun{step_add, step_mul};

# indirect call through a data-dependent function pointer. neither compiler can
# devirtualise it, so this is call overhead with inlining taken off the table
fun k_call_indirect() f64 {
    var acc: i64 = 0;
    var i: i64 = 0;
    for (i < d.N_SMALL) {
        val f: StepFun = steps[(d.i32_a[i] & 1)::i64];
        acc = acc + (f(d.i32_a[i] & 0xFF)::i64);
        i = i + 1;
    }
    ret acc::f64;
}

# array-of-structures traversal: six f32 fields at a 24-byte stride. the f64
# accumulator keeps the result exact, so this stays a bit-exact comparison
fun k_rec_particle() f64 {
    val dt: f32 = 0.00390625;
    var acc: f64 = 0.0;
    var i: i64 = 0;
    for (i < d.N_PART) {
        acc = acc + (d.parts[i].x + d.parts[i].vx * dt)::f64
                  + (d.parts[i].y + d.parts[i].vy * dt)::f64
                  + (d.parts[i].z + d.parts[i].vz * dt)::f64;
        i = i + 1;
    }
    ret acc;
}

# pointer chasing over a random Hamiltonian cycle. every load depends on the
# previous one, so this is memory latency with prefetching defeated
fun k_list_walk() f64 {
    var p: i32 = 0;
    var acc: i64 = 0;
    var i: i64 = 0;
    for (i < d.N_SMALL) {
        p = d.chase[p::i64];
        acc = acc + p::i64;
        i = i + 1;
    }
    ret acc::f64;
}

# branchy dispatch over an unpredictable opcode stream. Mach has no switch, so
# both sides use an if/else chain and the comparison stays like-for-like
fun k_branch_dispatch() f64 {
    var acc: i64 = 0;
    var reg: i64 = 1;
    var i: i64 = 0;
    for (i < d.N_BYTES) {
        val op: i64 = (d.u8_a[i] & 3)::i64;
        if (op == 0) {
            reg = reg + 3;
        }
        or (op == 1) {
            reg = reg ^ 0x5A;
        }
        or (op == 2) {
            reg = (reg >> 1) + 1;
        }
        or {
            acc = acc + (reg & 0xFF);
        }
        i = i + 1;
    }
    ret acc::f64;
}

# insertion sort over independent blocks -- compare, branch and shift heavy, and
# refilled each call so it stays idempotent
fun k_sort_blocks() f64 {
    var i: i64 = 0;
    for (i < d.N_SORT) {
        d.sortbuf[i] = d.i32_a[i];
        i = i + 1;
    }

    var b: i64 = 0;
    for (b < d.N_SORT) {
        i = b + 1;
        for (i < b + d.SORT_BLOCK) {
            val v: i32 = d.sortbuf[i];
            var j: i64 = i - 1;
            for (j >= b && d.sortbuf[j] > v) {
                d.sortbuf[j + 1] = d.sortbuf[j];
                j = j - 1;
            }
            d.sortbuf[j + 1] = v;
            i = i + 1;
        }
        b = b + d.SORT_BLOCK;
    }

    # position-weighted so a wrong ordering cannot checksum equal
    var acc: i64 = 0;
    i = 0;
    for (i < d.N_SORT) {
        acc = acc + (i + 1) * (d.sortbuf[i]::i64);
        i = i + 1;
    }
    ret acc::f64;
}

fun fib(n: i64) i64 {
    if (n < 2) { ret n; }
    ret fib(n - 1) + fib(n - 2);
}

# naive recursion: call overhead, stack traffic, and whatever the optimiser does
# with a self-recursive tree
fun k_recurse_fib() f64 {
    ret fib(d.FIB_N)::f64;
}

# naive substring search -- nested loop with an early exit
fun k_str_search() f64 {
    var found: i64 = 0 - 1;
    var i: i64 = 0;
    for (i + d.NEEDLE_LEN <= d.N_BYTES) {
        var k: i64 = 0;
        for (k < d.NEEDLE_LEN && d.u8_a[i + k] == d.needle[k]) {
            k = k + 1;
        }
        if (k == d.NEEDLE_LEN) {
            found = i;
            brk;
        }
        i = i + 1;
    }
    ret found::f64;
}

# binary search: unpredictable branches over a working set larger than L2
fun k_binsearch() f64 {
    var acc: i64 = 0;
    var q: i64 = 0;
    for (q < d.N_QUERY) {
        val key: i32 = ((d.i32_a[q] * 17 + (q::i32) * 3) % ((2 * d.N_SMALL)::i32));
        var lo: i64 = 0;
        var hi: i64 = d.N_SMALL - 1;
        var res: i64 = 0 - 1;
        for (lo <= hi) {
            val mid: i64 = (lo + hi) / 2;
            if (d.sorted_a[mid] == key) {
                res = mid;
                brk;
            }
            if (d.sorted_a[mid] < key) {
                lo = mid + 1;
            }
            or {
                hi = mid - 1;
            }
        }
        acc = acc + res;
        q = q + 1;
    }
    ret acc::f64;
}

# Mach-idiomatic error handling: res[i64, StepError] checked every iteration on
# a path that never fails. c/kernels.c uses an int status plus an
# out-parameter, so this measures each language's ordinary error-propagation
# idiom
tag StepError: u8 { negative; }

fun step_checked(v: i32) res[i64, StepError] {
    if (v < 0) { ret res[i64, StepError].err{StepError.negative{}}; }
    ret res[i64, StepError].ok{(v::i64) * 3 + 1};
}

fun k_result_chain() f64 {
    var acc: i64 = 0;
    var i: i64 = 0;
    for (i < d.N_SMALL) {
        val r: res[i64, StepError] = step_checked(d.i32_a[i]);
        if (sel r.err) { ret 0.0 - 1.0; }
        acc = acc + r.ok;
        i = i + 1;
    }
    ret acc::f64;
}

# the registry, in the same order as c/kernels.c.
# adding a kernel means bumping REGISTRY_LEN and adding the matching entry in
# c/kernels.c -- the two registries must stay name-for-name identical.
pub val REGISTRY_LEN: i64 = 19;

val G_LOOPS:   str = "array loops";
val G_GENERAL: str = "general codegen";

pub val REGISTRY: [REGISTRY_LEN]h.Kernel = [REGISTRY_LEN]h.Kernel{
    h.Kernel{name: "f32_saxpy",       fn: k_f32_saxpy,       iters: 100, tol: 0.0,    group: G_LOOPS},
    h.Kernel{name: "f64_dot",         fn: k_f64_dot,         iters: 100, tol: 0.0,    group: G_LOOPS},
    h.Kernel{name: "f32_norm",        fn: k_f32_norm,        iters: 100, tol: 0.001,  group: G_LOOPS},
    h.Kernel{name: "i32_madd",        fn: k_i32_madd,        iters: 100, tol: 0.0,    group: G_LOOPS},
    h.Kernel{name: "u8_count",        fn: k_u8_count,        iters: 50,  tol: 0.0,    group: G_LOOPS},
    h.Kernel{name: "u64_fnv1a",       fn: k_u64_fnv1a,       iters: 10,  tol: 0.0,    group: G_LOOPS},
    h.Kernel{name: "i32_filter_sum",  fn: k_i32_filter_sum,  iters: 100, tol: 0.0,    group: G_LOOPS},
    h.Kernel{name: "i64_prefix_sum",  fn: k_i64_prefix_sum,  iters: 100, tol: 0.0,    group: G_LOOPS},
    h.Kernel{name: "f32_matmul",      fn: k_f32_matmul,      iters: 10,  tol: 0.0001, group: G_LOOPS},
    h.Kernel{name: "stream_triad",    fn: k_stream_triad,    iters: 5,   tol: 0.0,    group: G_LOOPS},

    h.Kernel{name: "call_indirect",   fn: k_call_indirect,   iters: 50,  tol: 0.0,    group: G_GENERAL},
    h.Kernel{name: "rec_particle",    fn: k_rec_particle,    iters: 50,  tol: 0.0,    group: G_GENERAL},
    h.Kernel{name: "list_walk",       fn: k_list_walk,       iters: 20,  tol: 0.0,    group: G_GENERAL},
    h.Kernel{name: "branch_dispatch", fn: k_branch_dispatch, iters: 10,  tol: 0.0,    group: G_GENERAL},
    h.Kernel{name: "sort_blocks",     fn: k_sort_blocks,     iters: 20,  tol: 0.0,    group: G_GENERAL},
    h.Kernel{name: "recurse_fib",     fn: k_recurse_fib,     iters: 5,   tol: 0.0,    group: G_GENERAL},
    h.Kernel{name: "str_search",      fn: k_str_search,      iters: 20,  tol: 0.0,    group: G_GENERAL},
    h.Kernel{name: "binsearch",       fn: k_binsearch,       iters: 20,  tol: 0.0,    group: G_GENERAL},
    h.Kernel{name: "result_chain",    fn: k_result_chain,    iters: 100, tol: 0.0,    group: G_GENERAL}
};
